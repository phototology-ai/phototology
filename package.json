{
  "name": "phototology-public",
  "private": true,
  "version": "0.0.0",
  "description": "Workspace root for the public Phototology packages (phototology-ai/phototology). Synced from upstream; do not develop here.",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @phototology/sdk build && pnpm --filter @phototology/mcp build",
    "typecheck": "pnpm --filter @phototology/sdk typecheck && pnpm --filter @phototology/mcp typecheck",
    "test": "pnpm --filter @phototology/sdk test && pnpm --filter @phototology/mcp test",
    "check:surface": "node scripts/public-surface/check.mjs .",
    "check:pack": "node scripts/public-surface/check-pack.mjs packages/sdk packages/mcp packages/phototology"
  }
}
